# Variables locales para PostgreSQL 18 y las migraciones de Insumap.
# Copia este archivo a .env y cambia la contraseña. Nunca subas .env a git.

# Usuario, contraseña y base que crea Docker Compose en el primer arranque.
POSTGRES_USER=insumap
POSTGRES_PASSWORD=cambia-esto-password-local
POSTGRES_DB=insumap

# URL que usa Alembic y las pruebas para migrar. Debe coincidir con las
# variables de arriba. Las contraseñas de los roles SQL de la aplicación no
# van aquí ni en las migraciones.
DATABASE_URL_MIGRATOR=postgresql://insumap:cambia-esto-password-local@localhost:5432/insumap
